{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/((?!sw\\.js$|api/limpar).*)",
      "has": [
        {
          "type": "host",
          "value": "globalhiring.com.br"
        }
      ],
      "destination": "https://www.globalhiring.com.br/$1",
      "permanent": true
    },
    {
      "source": "/vagas.html",
      "destination": "/vagas",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/limpar",
      "destination": "/api/limpar.html"
    },
    {
      "source": "/vagas",
      "destination": "/vagas.html"
    },
    {
      "source": "/vagas/",
      "destination": "/vagas.html"
    },
    {
      "source": "/((?!assets/|fonts/|sw\\.js|workbox-).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/limpar(\\.html)?",
      "headers": [
        {
          "key": "Clear-Site-Data",
          "value": "\"cache\", \"storage\""
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
